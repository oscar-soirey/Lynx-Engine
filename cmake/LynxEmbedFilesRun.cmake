# Script mode of lynx_embed_files (LynxEmbedFiles.cmake) : OUTPUT, ROOT, FILES.

string(REPLACE "|" ";" FILES "${FILES}")

set(content "#pragma once\n// Generated by cmake/LynxEmbedFiles.cmake : do not edit.\n#include <cstddef>\n\n")
string(APPEND content "struct LynxEmbeddedFile { const char* path; const unsigned char* data; size_t size; };\n\n")

set(index 0)
set(table "")
foreach(entry IN LISTS FILES)
	# "<file>=<name>" gives the name ; otherwise the path relative to ROOT
	if(entry MATCHES "^(.*)=([^=]+)$")
		set(file "${CMAKE_MATCH_1}")
		set(relative "${CMAKE_MATCH_2}")
	else()
		set(file "${entry}")
		file(RELATIVE_PATH relative "${ROOT}" "${file}")
	endif()
	if(NOT EXISTS "${file}")
		message(FATAL_ERROR "lynx_embed_files: ${file} does not exist")
	endif()
	file(READ "${file}" hex HEX)
	string(LENGTH "${hex}" hex_length)
	math(EXPR size "${hex_length} / 2")
	# 0x.., per byte ; a trailing 0 keeps text files usable as C strings
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(APPEND content "static const unsigned char kLynxEmbedded${index}[] = {${bytes}0x00};\n")
	string(APPEND table "\t{ \"ui/${relative}\", kLynxEmbedded${index}, ${size} },\n")
	math(EXPR index "${index} + 1")
endforeach()

string(APPEND content "\nstatic const LynxEmbeddedFile kLynxEmbeddedFiles[] = {\n${table}};\n")
string(APPEND content "static constexpr size_t kLynxEmbeddedFileCount = ${index};\n")

# Written only when it changed : no rebuild of RavenUi.cpp otherwise.
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" previous)
	if(previous STREQUAL content)
		return()
	endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
