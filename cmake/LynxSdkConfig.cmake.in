# =============================================================================
# Lynx engine package : SDK of an installed engine (relocatable)
# -----------------------------------------------------------------------------
# Generated by the engine build in <build>/sdk/cmake, shipped in the release
# archive. The launcher installs a version in %LOCALAPPDATA%\Lynx\versions\<tag>\
# and registers <tag>\sdk\cmake in the CMake package registry. A game project uses
# the engine with :
#
#     find_package(Lynx REQUIRED)
#     target_link_libraries(MyGame PRIVATE Lynx::Lynx Lynx::HRL)
#
# Layout (paths relative to this file, the folder can be moved) :
#   <version>/libLynx.dll, LynxEditor.exe...      engine binaries
#   <version>/sdk/cmake/                          this file, LynxPlugin.cmake
#   <version>/sdk/lib/libLynx.dll.a               import library
#   <version>/sdk/src/, sdk/third-party/          headers (+ ImGui sources for plugins)
# =============================================================================

get_filename_component(LYNX_SDK_DIR     "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(LYNX_INSTALL_DIR "${LYNX_SDK_DIR}/.." ABSOLUTE)

# Same variables as the package of an engine build folder (LynxConfig.cmake.in)
set(LYNX_SOURCE_DIR "${LYNX_SDK_DIR}")
set(LYNX_BUILD_DIR  "${LYNX_INSTALL_DIR}")
set(LYNX_VERSION    "@LYNX_VERSION@")

# The game DLL shares C++ objects with lynx.dll (std::string, std::vector...) :
# it must be built by the same compiler.
set(LYNX_CXX_COMPILER_ID      "@CMAKE_CXX_COMPILER_ID@")
set(LYNX_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")

if(CMAKE_CXX_COMPILER_ID AND NOT CMAKE_CXX_COMPILER_ID STREQUAL LYNX_CXX_COMPILER_ID)
	message(FATAL_ERROR
		"The Lynx engine ${LYNX_VERSION} (${LYNX_INSTALL_DIR}) was built with ${LYNX_CXX_COMPILER_ID} "
		"${LYNX_CXX_COMPILER_VERSION}, this project uses ${CMAKE_CXX_COMPILER_ID} "
		"${CMAKE_CXX_COMPILER_VERSION}. Use the same compiler (ex : -G \"MinGW Makefiles\" "
		"with the MinGW installed by the Lynx launcher).")
endif()

if(NOT TARGET Lynx::Lynx)
	add_library(Lynx::Lynx SHARED IMPORTED)
	set_target_properties(Lynx::Lynx PROPERTIES
		IMPORTED_IMPLIB               "${LYNX_SDK_DIR}/lib/@LYNX_IMPLIB_NAME@"
		IMPORTED_LOCATION             "${LYNX_INSTALL_DIR}/@LYNX_DLL_NAME@"
		INTERFACE_INCLUDE_DIRECTORIES "${LYNX_SDK_DIR}/third-party/tracy;${LYNX_SDK_DIR}/src;${LYNX_SDK_DIR}/third-party"
		INTERFACE_COMPILE_DEFINITIONS "@LYNX_SDK_DEFINITIONS@"
		INTERFACE_COMPILE_FEATURES    "cxx_std_20"
	)
endif()

# HRL (renderer) : games call it directly.
if(NOT TARGET Lynx::HRL)
	add_library(Lynx::HRL UNKNOWN IMPORTED)
	set_target_properties(Lynx::HRL PROPERTIES
		IMPORTED_LOCATION "${LYNX_SDK_DIR}/third-party/hrl/lib/libhrldll.dll.a"
	)
endif()

# lynx_add_plugin (plugins of a game project) : include("${Lynx_DIR}/LynxPlugin.cmake")
set(LYNX_ROOT_DIR      "${LYNX_SDK_DIR}")
set(LYNX_ENGINE_TARGET Lynx::Lynx)
set(LYNX_HRL_LIB       "${LYNX_SDK_DIR}/third-party/hrl/lib/libhrldll.dll.a")

set(Lynx_FOUND TRUE)
