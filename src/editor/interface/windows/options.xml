<?xml version="1.0" encoding="UTF-8"?>
<!-- A window of its own (not docked) : opened by the editor, closing it hides it. -->
<Window Title="Lynx - Options" Width="560" Height="660" MinWidth="320" MinHeight="240" Hidden="true">
<!-- Options : interface (every project), project settings (settings.cfg), plugins. -->
<TabView Name="options">
	<ScrollBox Slot.Title="Interface">
		<VBox Spacing="6" Slot.Padding="10">
			<Section Text="UI scale"/>
			<Label Text="Size of the text and of every widget of the editor." Class="dim"/>
			<HBox Spacing="6">
				<Slider Name="options.scale" Min="50" Max="200" Step="5" Value="100" Width="220"/>
				<Label Name="options.scale.value" Text="100 %" Width="56" Slot.VAlign="Center"/>
			</HBox>
			<HBox Spacing="4">
				<Button Name="options.scale.75" Text="75%"/>
				<Button Name="options.scale.100" Text="100%"/>
				<Button Name="options.scale.125" Text="125%"/>
				<Button Name="options.scale.150" Text="150%"/>
				<Button Name="options.scale.200" Text="200%"/>
			</HBox>

			<Section Text="Theme"/>
			<ComboBox Name="options.theme" Width="240"/>
			<Checkbox Name="options.rounded" Text="Rounded corners"/>
			<HBox Spacing="4">
				<Button Name="options.theme.new" Text="New theme" Tooltip="Creates a theme file from a commented template and opens it. Saved changes are applied right away."/>
				<Button Name="options.theme.edit" Text="Edit" Tooltip="Opens the file of this theme (your own themes only)."/>
				<Button Name="options.theme.folder" Text="Open themes folder"/>
			</HBox>
			<Label Name="options.theme.info" Text="Your themes : every .xml file of the themes folder. Saving one applies it at once." Class="dim" Wrap="true"/>

			<Separator Slot.Padding="0,8"/>
			<Button Name="options.reset" Text="Reset interface"/>
		</VBox>
	</ScrollBox>

	<ScrollBox Slot.Title="Project">
		<VBox Spacing="6" Slot.Padding="10">
			<Label Text="Settings of this project (settings.cfg)." Class="dim"/>
			<Section Text="Game DLL"/>
			<Checkbox Name="project.reload_after_build" Text="Reload the game after &quot;Compile&quot;"/>
			<Checkbox Name="project.auto_reload" Text="Reload the game when its DLL is rebuilt" Tooltip="Build.bat or CLion rebuilt build/&lt;game&gt;.dll while the editor runs. While playing, the reload waits for Stop."/>
			<Section Text="Display"/>
			<Checkbox Name="project.vsync" Text="VSync" Tooltip="The editor waits for the screen between two frames."/>
			<Section Text="Audio"/>
			<PropertyRow Label="Master volume">
				<Slider Name="project.volume" Min="0" Max="2" Step="0.01" Slot.Fill="1"/>
				<Label Name="project.volume.value" Width="44" TextAlign="Right" Slot.VAlign="Center"/>
			</PropertyRow>
			<Section Text="Editor camera"/>
			<PropertyRow Label="Camera speed">
				<Slider Name="project.camera_speed" Min="1" Max="400" Step="1" Slot.Fill="1"/>
				<Label Name="project.camera_speed.value" Width="44" TextAlign="Right" Slot.VAlign="Center"/>
			</PropertyRow>
			<Section Text="Renderer"/>
			<PropertyRow Label="Game renderer">
				<ComboBox Name="project.renderer" Items="Vulkan|OpenGL" Slot.Fill="1" Tooltip="Graphics API of the game (Lynx Runtime, shipped game). Vulkan falls back to OpenGL on a computer without Vulkan. Command line : --vulkan / --opengl."/>
			</PropertyRow>
			<Label Text="Applied the next time the game starts. The editor Viewport is drawn by OpenGL inside the Vulkan interface." Class="dim" Wrap="true"/>
			<Section Text="Voxels"/>
			<PropertyRow Label="Render mode">
				<ComboBox Name="project.render_mode" Items="Flat|Smooth|Blocky" Slot.Fill="1"/>
			</PropertyRow>
			<Label Text="Units : 1 = 1 voxel (positions, sizes, speeds)" Class="dim"/>
			<Separator Slot.Padding="0,8"/>
			<Button Name="project.reset" Text="Reset project settings"/>
		</VBox>
	</ScrollBox>

	<ScrollBox Slot.Title="Plugins">
		<VBox Name="plugins.page" Spacing="8" Slot.Padding="12">
			<HBox Spacing="8">
				<VBox Spacing="2" Slot.Fill="1">
					<Label Text="Plugins" Class="dialog-title"/>
					<Label Name="plugins.summary" Text="" Class="dim" Wrap="true"/>
				</VBox>
				<Button Name="plugins.folder" Text="Project plugins folder" Slot.VAlign="Center" Tooltip="&lt;project&gt;/plugins : a folder per plugin (plugin.json + bin/)"/>
			</HBox>
			<HBox Spacing="6">
				<TextInput Name="plugins.search" Placeholder="Search (name, author, description)" Slot.Fill="1"/>
				<ComboBox Name="plugins.filter" Items="All|Enabled|Disabled|Engine|Project" Width="130"/>
			</HBox>
			<Label Name="plugins.restart" Text="Saved in plugins.json : restart the editor to load or unload the plugins you changed." Class="warning" Wrap="true" Visibility="Collapsed"/>
			<VBox Name="plugins.list" Spacing="8"/>
			<Label Text="More plugins : the Lynx launcher (Plugins tab) installs them into an engine version." Class="dim" Wrap="true" Slot.Padding="0,6,0,0"/>
		</VBox>
	</ScrollBox>

	<ScrollBox Slot.Title="Keyboard">
		<VBox Spacing="4" Slot.Padding="10">
			<Label Text="Shortcuts of the editor, the same for every project. Click a shortcut, then press the new keys (Ctrl / Shift / Alt + a key). Escape cancels." Class="dim" Wrap="true"/>
			<Label Name="keys.hint" Text="" Class="warning"/>
			<VBox Name="keys.list" Spacing="2"/>
			<Separator Slot.Padding="0,8"/>
			<Button Name="keys.reset_all" Text="Reset every shortcut" Slot.HAlign="Left"/>
			<Label Text="The editors in tabs (Widget Editor, Behavior Tree, Anim Graph) keep Ctrl+S, Ctrl+Z, Ctrl+Y, Ctrl+D, Delete while they have the keyboard." Class="dim" Wrap="true"/>
		</VBox>
	</ScrollBox>
</TabView>
</Window>
