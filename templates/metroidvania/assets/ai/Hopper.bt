<?xml version="1.0" encoding="UTF-8"?>
<!-- Hopper : the player is close -> crouches, leaps toward him, rests. -->
<BehaviorTree version="1">
    <Blackboard>
        <Key name="target" type="actor"/>
        <Key name="distance" type="float" default="999"/>
    </Blackboard>
    <Node id="1" parent="0" type="Root" x="0" y="0"/>
    <Node id="2" parent="1" type="Selector" x="0" y="140">
        <Service id="101" type="FindNearest" tag="player" radius="26" result="target" interval="0.3"/>
        <Service id="102" type="DistanceTo" target="target" result="distance" interval="0.15"/>
    </Node>
    <Node id="3" parent="2" type="Sequence" x="-260" y="300">
        <Decorator id="103" type="Blackboard" key="distance" op="&lt;" value="22"/>
    </Node>
    <Node id="4" parent="3" type="CallFunction" x="-360" y="460" function="Crouch"/>
    <Node id="5" parent="3" type="CallFunction" x="-200" y="460" function="Leap"/>
    <Node id="6" parent="3" type="Wait" x="-60" y="460" time="0.6" random="0.3"/>
    <Node id="7" parent="2" type="CallFunction" x="260" y="300" function="Idle"/>
</BehaviorTree>
