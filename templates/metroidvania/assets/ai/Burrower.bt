<?xml version="1.0" encoding="UTF-8"?>
<!-- Burrower : digs through the dirt (Voxels.destroyCircle) toward the player, erupts under him, stays exposed a moment, dives again. -->
<BehaviorTree version="1">
    <Blackboard>
        <Key name="target" type="actor"/>
        <Key name="distance" type="float" default="999"/>
    </Blackboard>
    <Node id="1" parent="0" type="Root" x="0" y="0"/>
    <Node id="2" parent="1" type="Selector" x="0" y="140">
        <Service id="101" type="FindNearest" tag="player" radius="40" result="target" interval="0.3"/>
        <Service id="102" type="DistanceTo" target="target" result="distance" interval="0.15"/>
    </Node>
    <Node id="3" parent="2" type="Sequence" x="-300" y="300">
        <Decorator id="103" type="Blackboard" key="target" op="isSet"/>
        <Decorator id="104" type="Cooldown" time="1.5"/>
    </Node>
    <Node id="4" parent="3" type="CallFunction" x="-460" y="460" function="Burrow"/>
    <Node id="5" parent="3" type="CallFunction" x="-300" y="460" function="Erupt"/>
    <Node id="6" parent="3" type="CallFunction" x="-140" y="460" function="Exposed"/>
    <Node id="7" parent="2" type="CallFunction" x="300" y="300" function="Lurk"/>
</BehaviorTree>
