+#ifndef IMGUI_DISABLE_PIXEL_STYLE
+// [PIXEL STYLE] Graph paper : 1px lines snapped to whole pixels (no blurry half pixels when the
+// canvas is panned), a darker line every GridMajorLinesEvery cells, origin lines when
+// ImNodesStyleFlags_GridLinesPrimary is set.
+void DrawGrid(ImNodesEditorContext& editor, const ImVec2& canvas_size)
+{
+    const float step = ImMax(2.0f, IM_TRUNC(GImNodes->Style.GridSpacing));
+    const ImVec2 offset = editor.Panning;
+    const ImVec2 origin = GImNodes->CanvasOriginScreenSpace;
+    const ImU32  line_color = GImNodes->Style.Colors[ImNodesCol_GridLine];
+    const ImU32  line_color_major = GImNodes->Style.Colors[ImNodesCol_GridLinePrimary];
+    const bool   draw_origin = (GImNodes->Style.Flags & ImNodesStyleFlags_GridLinesPrimary) != 0;
+    const int    every = GImNodes->Style.GridMajorLinesEvery;
+    ImDrawList*  draw_list = GImNodes->CanvasDrawList;
+
+    for (int axis = 0; axis < 2; ++axis)
+    {
+        const float pan = axis == 0 ? offset.x : offset.y;
+        const float length = axis == 0 ? canvas_size.x : canvas_size.y;
+        // Index of the first visible line (lines sit at grid positions k * step).
+        int   index = (int)ImFloor(-pan / step);
+        float pos = pan + (float)index * step;
+        for (; pos < length; pos += step, ++index)
+        {
+            if (pos < 0.0f)
+                continue;
+            const bool major = (every > 0 && index % every == 0) || (draw_origin && index == 0);
+            const ImU32 col = major ? line_color_major : line_color;
+            if (axis == 0)
+            {
+                const float x = ImFloor(origin.x + pos);
+                draw_list->AddRectFilled(ImVec2(x, origin.y), ImVec2(x + 1.0f, origin.y + canvas_size.y), col);
+            }
+            else
+            {
+                const float y = ImFloor(origin.y + pos);
+                draw_list->AddRectFilled(ImVec2(origin.x, y), ImVec2(origin.x + canvas_size.x, y + 1.0f), col);
+            }
+        }
+    }
+}
