+void StylePixel(ImNodesStyle* dest)
+{
+    if (dest == nullptr)
+    {
+        dest = &GImNodes->Style;
+    }
+
+    // Sizes : the pixel defaults of ImNodesStyle(), grid aligned on the ImGui window grid.
+    ImNodesStyle defaults;
+    for (int i = 0; i < ImNodesCol_COUNT; ++i)
+        defaults.Colors[i] = dest->Colors[i];
+    *dest = defaults;
+#ifndef IMGUI_DISABLE_PIXEL_STYLE
+    if (ImGui::GetStyle().WindowGridSize >= 2.0f)
+        dest->GridSpacing = IM_TRUNC(ImGui::GetStyle().WindowGridSize);
+#endif
+    StyleColorsPixel(dest);
+}
