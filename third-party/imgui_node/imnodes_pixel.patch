+void StyleColorsPixel(ImNodesStyle* dest)
+{
+    if (dest == nullptr)
+    {
+        dest = &GImNodes->Style;
+    }
+
+#ifdef IMGUI_DISABLE_PIXEL_STYLE
+    StyleColorsDark(dest);
+#else
+    const ImVec4* c = ImGui::GetStyle().Colors;
+    const ImVec4  window = c[ImGuiCol_WindowBg];
+    const ImVec4  text = c[ImGuiCol_Text];
+    const ImVec4  outline = c[ImGuiCol_Border];
+
+    // Canvas : the window color, a bit deeper, and the graph paper of the windows.
+    const ImVec4 canvas = PixelMix(window, outline, 0.06f);
+    const ImVec4 grid = c[ImGuiCol_WindowGrid];
+    dest->Colors[ImNodesCol_GridBackground] = PixelU32(canvas, 1.0f);
+    dest->Colors[ImNodesCol_GridLine] = PixelU32(grid, ImMax(grid.w, 0.035f));
+    dest->Colors[ImNodesCol_GridLinePrimary] = PixelU32(grid, ImMin(1.0f, ImMax(grid.w, 0.035f) * 2.6f));
+
+    // Nodes : small windows (panel color, black 1px outline, title bar in the selection colors).
+    dest->Colors[ImNodesCol_NodeBackground] = PixelU32(window, 1.0f);
+    dest->Colors[ImNodesCol_NodeBackgroundHovered] = PixelU32(PixelMix(window, text, 0.05f), 1.0f);
+    dest->Colors[ImNodesCol_NodeBackgroundSelected] = dest->Colors[ImNodesCol_NodeBackgroundHovered];
+    dest->Colors[ImNodesCol_NodeOutline] = PixelU32(outline, 1.0f);
+    dest->Colors[ImNodesCol_NodeOutlineSelected] = PixelU32(c[ImGuiCol_NavCursor], 1.0f);
+    dest->Colors[ImNodesCol_TitleBar] = PixelU32(c[ImGuiCol_Header], 1.0f);
+    dest->Colors[ImNodesCol_TitleBarHovered] = PixelU32(c[ImGuiCol_HeaderHovered], 1.0f);
+    dest->Colors[ImNodesCol_TitleBarSelected] = PixelU32(c[ImGuiCol_HeaderActive], 1.0f);
