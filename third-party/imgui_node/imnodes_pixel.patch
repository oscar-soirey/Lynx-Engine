+// [PIXEL STYLE] Pixel-art pins : discs and squares built from 1px rows, centered on a pixel, with a
+// 1px outline (node outline color) like the ImGui pixel widgets. Triangles keep the stock drawing.
+static void PixelDisc(ImDrawList* draw_list, const ImVec2& center, float radius, ImU32 col)
+{
+    const int r = ImMax(1, (int)ImFloor(radius + 0.5f));
+    for (int dy = -r; dy <= r; ++dy)
+    {
+        const int half = (int)ImFloor(ImSqrt((float)(r * r - dy * dy)) + 0.5f);
+        draw_list->AddRectFilled(
+            ImVec2(center.x - (float)half, center.y + (float)dy),
+            ImVec2(center.x + (float)half + 1.0f, center.y + (float)dy + 1.0f),
+            col);
+    }
+}
+
+static void PixelSquare(ImDrawList* draw_list, const ImVec2& center, float half, ImU32 col)
+{
+    draw_list->AddRectFilled(
+        ImVec2(center.x - half, center.y - half), ImVec2(center.x + half + 1.0f, center.y + half + 1.0f), col);
+}
+
+static bool DrawPinShapePixel(const ImVec2& pin_pos, const ImPinData& pin, const ImU32 pin_color)
+{
+    ImDrawList*  draw_list = GImNodes->CanvasDrawList;
+    const ImU32  outline = GImNodes->Style.Colors[ImNodesCol_NodeOutline];
+    const ImU32  hollow = GImNodes->Style.Colors[ImNodesCol_NodeBackground];
+    const ImVec2 c(ImFloor(pin_pos.x), ImFloor(pin_pos.y));
+
+    switch (pin.Shape)
+    {
+    case ImNodesPinShape_Circle:
+    case ImNodesPinShape_CircleFilled:
+    {
+        const float r = GImNodes->Style.PinCircleRadius;
+        PixelDisc(draw_list, c, r + 1.0f, outline);
+        PixelDisc(draw_list, c, r, pin_color);
+        if (pin.Shape == ImNodesPinShape_Circle && r >= 3.0f)
+            PixelDisc(draw_list, c, r - 2.0f, hollow);
+        return true;
+    }
+    case ImNodesPinShape_Quad:
+    case ImNodesPinShape_QuadFilled:
+    {
+        const float half = ImFloor(GImNodes->Style.PinQuadSideLength * 0.5f);
+        PixelSquare(draw_list, c, half + 1.0f, outline);
+        PixelSquare(draw_list, c, half, pin_color);
+        if (pin.Shape == ImNodesPinShape_Quad && half >= 3.0f)
+            PixelSquare(draw_list, c, half - 2.0f, hollow);
+        return true;
+    }
+    default:
+        return false;
+    }
+}
+#endif // IMGUI_DISABLE_PIXEL_STYLE
